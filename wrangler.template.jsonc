{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brick-family-v1",
  "main": "src/worker-v5b.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/1 * * * *", "17 3 * * *"] },
  "assets": {
    "directory": "./public",
    "base_path": "/parent-assets"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BRICK_DEVICE", "class_name": "BrickDevice" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BrickDevice"] }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "brick-family-v1", "database_id": "__D1_DATABASE_ID__" },
    { "binding": "MAP_DB", "database_name": "brick-family-v1-map", "database_id": "__MAP_D1_DATABASE_ID__" }
  ],
  "ratelimits": [
    { "name": "DEVICE_RATE", "namespace_id": "41001", "simple": { "limit": 120, "period": 60 } },
    { "name": "PAIR_RATE", "namespace_id": "41002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": { "APP_ENV": "production", "STORAGE_BACKEND": "d1" }
}
