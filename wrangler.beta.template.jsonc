{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brick-family-beta",
  "main": "src/worker-beta.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "*/1 * * * *",
      "17 3 * * *"
    ]
  },
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BRICK_DEVICE",
        "class_name": "BrickDevice"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BrickDevice"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brick-family-beta",
      "database_id": "__D1_DATABASE_ID__"
    },
    {
      "binding": "BETA_DB",
      "database_name": "brick-family-beta-diagnostics",
      "database_id": "__BETA_D1_DATABASE_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HISTORY",
      "bucket_name": "brick-family-beta-history"
    },
    {
      "binding": "MAPS",
      "bucket_name": "brick-family-beta-maps"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "brick-family-beta-events"
      }
    ],
    "consumers": [
      {
        "queue": "brick-family-beta-events",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "brick-family-beta-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "brick-family-beta-dlq",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "retry_delay": 300,
        "max_concurrency": 1
      }
    ]
  },
  "ratelimits": [
    {
      "name": "DEVICE_RATE",
      "namespace_id": "51001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PAIR_RATE",
      "namespace_id": "51002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PARENT_HISTORY_RATE",
      "namespace_id": "51003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PARENT_WS_RATE",
      "namespace_id": "51004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PARENT_GEOCODE_RATE",
      "namespace_id": "51005",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PARENT_COMMUTE_RATE",
      "namespace_id": "51006",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "BETA_RATE",
      "namespace_id": "51007",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "BETA_PARENT_RATE",
      "namespace_id": "51008",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "CURRENT_APP_VERSION": "1.0.0-beta.1",
    "CF_ACCESS_TEAM_DOMAIN": "__CF_ACCESS_TEAM_DOMAIN__",
    "CF_ACCESS_AUD": "__CF_ACCESS_AUD__",
    "BETA_CHANNEL": "beta",
    "BETA_SOURCE_SHA": "__BETA_SOURCE_SHA__"
  }
}
