{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brick-family-beta",
  "main": "src/worker-beta-cardfree.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BRICK_DEVICE",
        "class_name": "BrickDevice"
      },
      {
        "name": "BETA_SCHEDULER",
        "class_name": "BetaScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BrickDevice"
      ]
    },
    {
      "tag": "beta-scheduler-v1",
      "new_sqlite_classes": [
        "BetaScheduler"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brick-family-beta",
      "database_id": "__D1_DATABASE_ID__"
    },
    {
      "binding": "BETA_DB",
      "database_name": "brick-family-beta-diagnostics",
      "database_id": "__BETA_D1_DATABASE_ID__"
    }
  ],
  "ratelimits": [
    {
      "name": "DEVICE_RATE",
      "namespace_id": "51001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PAIR_RATE",
      "namespace_id": "51002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PARENT_HISTORY_RATE",
      "namespace_id": "51003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PARENT_WS_RATE",
      "namespace_id": "51004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PARENT_GEOCODE_RATE",
      "namespace_id": "51005",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PARENT_COMMUTE_RATE",
      "namespace_id": "51006",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "BETA_RATE",
      "namespace_id": "51007",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "BETA_PARENT_RATE",
      "namespace_id": "51008",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PARENT_LOGIN_RATE",
      "namespace_id": "51009",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "CURRENT_APP_VERSION": "1.0.0-beta.1",
    "BETA_CHANNEL": "beta",
    "BETA_SOURCE_SHA": "__BETA_SOURCE_SHA__",
    "DEV_PARENT_AUTH_MODE": "d1-session-v1",
    "BETA_STORAGE_MODE": "d1",
    "BRICK_MAP_SOURCE": "__BRICK_MAP_SOURCE__"
  },
  "triggers": {
    "crons": []
  }
}
